{
  "ai": {
    "provider": "openai",
    "model": "qwen/qwen3.8-27b",
    "base_url": "https://api.groq.com/openai/v1",
    "api_key_env": "GROQ_API_KEY",
    "fallback_api_key_envs": [
      "GROQ_API_KEY_2",
      "GROQ_API_KEY_3"
    ],
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 12,
    "languages": [
      "ru"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "ai-creator": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "hackernews": {
      "enabled": false
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "platform": "telegram",
    "languages": null,
    "request_body": {
      "chat_id": "${TELEGRAM_CHAT_ID}",
      "rich_message": {
        "markdown": "#{summary}"
      }
    }
  }
}
